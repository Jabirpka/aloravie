# Copy to .env and fill in. Never commit .env.

# Server
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aloravie?schema=public"

# Auth — generate strong random values for each (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# CORS — comma-separated list of allowed origins (storefront :3000, admin :3001)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:5173"

# Payments
# mock  = no real gateway; the storefront can simulate a successful payment (dev only)
# razorpay = use Razorpay (requires the keys below; UPI, cards, netbanking, wallets)
# In production PAYMENT_MODE must be razorpay and RAZORPAY_WEBHOOK_SECRET must be set.
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set this to the secret you configure on the Razorpay webhook (Dashboard → Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# File storage
# local = write to ./uploads, served at /uploads (dev only; a PaaS disk is wiped on redeploy)
# s3    = upload to an S3-compatible bucket (AWS S3 / Cloudflare R2). Required in production.
STORAGE_DRIVER=local
# For s3: R2 endpoint https://<account-id>.r2.cloudflarestorage.com (region stays "auto")
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL files are served from (R2 public bucket URL or a CDN domain), no trailing slash
STORAGE_PUBLIC_URL=

# Pricing rules (paise). Flat shipping below the free-shipping threshold.
SHIPPING_FLAT_MINOR=9900
FREE_SHIP_THRESHOLD_MINOR=149900

# Fulfilment / courier
# mock = no real courier; shipments get a simulated AWB + tracking (dev)
# shiprocket = use Shiprocket (requires the credentials below)
COURIER_MODE=mock
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Seller identity — printed on invoices, delivery notes and labels
SELLER_NAME=Aloravie
SELLER_GSTIN=
SELLER_ADDRESS="Bengaluru, Karnataka, India"
SELLER_STATE=Karnataka
SELLER_EMAIL=care@aloravie.example
SELLER_PHONE=

# Marketplace sync
# mock = simulate inventory push + generate sample marketplace orders (dev)
# live = real connectors (each marketplace needs its own seller credentials)
MARKETPLACE_MODE=mock

# Notifications (email / SMS / WhatsApp)
# mock = log + record without sending; live = use the providers below
NOTIFY_MODE=mock
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
