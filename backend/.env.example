# Copy to .env and fill in. Never commit .env.

# Server
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aloravie?schema=public"

# Auth — generate strong random values for each (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# CORS — comma-separated list of allowed origins (storefront :3000, admin :3001)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:5173"

# Payments
# mock  = no real gateway; the storefront can simulate a successful payment (dev only)
# razorpay = use Razorpay (requires the keys below; UPI, cards, netbanking, wallets)
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Pricing rules (paise). Flat shipping below the free-shipping threshold.
SHIPPING_FLAT_MINOR=9900
FREE_SHIP_THRESHOLD_MINOR=149900
