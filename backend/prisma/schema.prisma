// Aloravie commerce platform — data model (Phase 0).
// Money: all amounts are integer MINOR units (paise for INR) in a `*Minor` field,
// always paired with a `currency` code. Never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

// Staff / admin who operate the back office.
enum UserRole {
  OWNER
  ADMIN
  STAFF
}

// Operational departments. OWNER/ADMIN bypass these (full access); STAFF are
// gated to the features their departments grant.
enum Department {
  RETURNS
  PACKING
  CUSTOMER_CARE
  OFFERS
  CRM
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  role         UserRole     @default(STAFF)
  departments  Department[] @default([])
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  refreshTokens RefreshToken[]

  @@map("users")
}

// Rotating refresh tokens (stored hashed, revocable).
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Shoppers on the storefront and marketplaces.
model Customer {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  name         String?
  passwordHash String? // null for marketplace/guest customers who never set one
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses             Address[]
  orders                Order[]
  refreshTokens         CustomerRefreshToken[]
  supportConversations  SupportConversation[]
  returns               ReturnRequest[]

  @@map("customers")
}

// Rotating refresh tokens for storefront customers (stored hashed, revocable).
model CustomerRefreshToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
  @@map("customer_refresh_tokens")
}

enum AddressType {
  SHIPPING
  BILLING
}

model Address {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       AddressType @default(SHIPPING)
  name       String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  country    String      @default("IN")
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@index([customerId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("categories")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?
  status      ProductStatus @default(DRAFT)
  model3dUrl  String? // glTF/GLB model for the 3D catalogue viewer
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  variants    ProductVariant[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

// The sellable unit: carries SKU, price and the inventory link.
model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String   @unique
  name       String   // e.g. "M / Terracotta"
  priceMinor Int      // minor units (paise)
  currency   String   @default("INR")
  barcode    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  inventory  InventoryItem[]
  orderItems OrderItem[]
  listings   ChannelListing[]

  @@index([productId])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model Location {
  id        String          @id @default(cuid())
  name      String
  code      String          @unique
  isDefault Boolean         @default(false)
  createdAt DateTime        @default(now())

  inventory InventoryItem[]

  @@map("locations")
}

// Stock of a variant at a location. `available = onHand - reserved`.
model InventoryItem {
  id         String         @id @default(cuid())
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId String
  location   Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  onHand     Int            @default(0)
  reserved   Int            @default(0)
  updatedAt  DateTime       @updatedAt

  @@unique([variantId, locationId])
  @@index([variantId])
  @@map("inventory_items")
}

// ---------------------------------------------------------------------------
// Channels & orders
// ---------------------------------------------------------------------------

enum ChannelType {
  WEB
  AMAZON
  FLIPKART
  MYNTRA
  MEESHO
  AJIO
  NYKAA
}

// A place orders come from. Marketplace orders flow through the same pipeline.
model SalesChannel {
  id              String    @id @default(cuid())
  type            ChannelType
  name            String
  isActive        Boolean   @default(true)
  connected       Boolean   @default(false) // seller account linked / credentials set
  config          Json? // per-channel settings/credentials reference (never raw secrets in prod)
  lastOrderSyncAt DateTime?
  createdAt       DateTime  @default(now())

  orders   Order[]
  listings ChannelListing[]
  syncLogs SyncLog[]

  @@unique([type])
  @@map("sales_channels")
}

// Maps one of our variants to its listing on a marketplace channel.
model ChannelListing {
  id            String       @id @default(cuid())
  channelId     String
  channel       SalesChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  externalSku   String // the SKU/listing id on the marketplace
  isActive      Boolean      @default(true)
  lastPushedQty Int?
  lastSyncedAt  DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([channelId, variantId])
  @@index([channelId])
  @@map("channel_listings")
}

enum SyncType {
  INVENTORY_PUSH
  ORDER_PULL
}

enum SyncStatus {
  OK
  PARTIAL
  FAILED
}

// A record of each sync run, for admin visibility.
model SyncLog {
  id        String       @id @default(cuid())
  channelId String
  channel   SalesChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  type      SyncType
  status    SyncStatus
  count     Int          @default(0)
  message   String?
  createdAt DateTime     @default(now())

  @@index([channelId])
  @@map("sync_logs")
}

enum OrderStatus {
  PENDING       // created, awaiting payment
  CONFIRMED     // paid / COD accepted
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

model Order {
  id            String       @id @default(cuid())
  orderNumber   String       @unique // human-facing, e.g. ALV-2026-00001
  channelId     String
  channel       SalesChannel @relation(fields: [channelId], references: [id])
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id])
  status        OrderStatus  @default(PENDING)

  // Contact + shipping snapshot (preserved at order time)
  email           String?
  phone           String?
  shippingAddress Json?

  // Money (minor units)
  currency      String       @default("INR")
  subtotalMinor Int          @default(0)
  shippingMinor Int          @default(0)
  taxMinor      Int          @default(0)
  discountMinor Int          @default(0)
  totalMinor    Int          @default(0)

  // External marketplace reference (null for WEB)
  externalId    String?

  placedAt      DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  items    OrderItem[]
  payment  Payment?
  shipment Shipment?
  returns  ReturnRequest[]

  @@index([status])
  @@index([channelId])
  @@index([customerId])
  @@map("orders")
}

enum PaymentProvider {
  RAZORPAY
  MOCK
  COD
  MARKETPLACE
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

// One payment attempt per order (one-to-one for now).
model Payment {
  id              String          @id @default(cuid())
  orderId         String          @unique
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        PaymentProvider
  status          PaymentStatus   @default(CREATED)
  amountMinor     Int
  currency        String          @default("INR")
  providerOrderId String? // e.g. Razorpay order id
  providerPaymentId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("payments")
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  titleSnapshot  String         // name at time of order
  skuSnapshot    String
  unitPriceMinor Int
  quantity       Int
  totalMinor     Int

  @@index([orderId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Fulfilment
// ---------------------------------------------------------------------------

enum CourierProvider {
  SHIPROCKET
  DELHIVERY
  MOCK
}

enum ShipmentStatus {
  CREATED
  LABEL_READY
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RTO
  CANCELLED
}

// One shipment per order (one-to-one for now).
model Shipment {
  id                 String          @id @default(cuid())
  orderId            String          @unique
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider           CourierProvider
  courierName        String
  awb                String? // tracking / air waybill number
  status             ShipmentStatus  @default(CREATED)
  trackingUrl        String?
  providerShipmentId String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  events TrackingEvent[]

  @@map("shipments")
}

model TrackingEvent {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     String // human-facing label, e.g. "Picked up"
  location   String?
  note       String?
  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@index([shipmentId])
  @@map("tracking_events")
}

// ---------------------------------------------------------------------------
// Engagement: notifications & support (Phase 7)
// ---------------------------------------------------------------------------

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationEvent {
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  SUPPORT_REPLY
}

enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

// A record of every notification attempt (for admin visibility + auditing).
model NotificationLog {
  id        String              @id @default(cuid())
  channel   NotificationChannel
  event     NotificationEvent
  recipient String
  subject   String?
  body      String
  status    NotificationStatus  @default(SENT)
  orderId   String?
  createdAt DateTime            @default(now())

  @@index([createdAt])
  @@map("notification_logs")
}

enum SupportStatus {
  OPEN
  CLOSED
}

enum MessageSender {
  CUSTOMER
  STAFF
  SYSTEM
}

model SupportConversation {
  id            String        @id @default(cuid())
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  subject       String
  status        SupportStatus @default(OPEN)
  guestName     String? // for not-signed-in visitors
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lastMessageAt DateTime      @default(now())

  messages SupportMessage[]

  @@index([status])
  @@index([customerId])
  @@map("support_conversations")
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         MessageSender
  body           String
  audioUrl       String? // voice note, when present
  createdAt      DateTime            @default(now())

  @@index([conversationId])
  @@map("support_messages")
}

// ---------------------------------------------------------------------------
// Returns (Phase 8)
// ---------------------------------------------------------------------------

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

enum ReturnReason {
  WRONG_SIZE
  DAMAGED
  NOT_AS_DESCRIBED
  CHANGED_MIND
  OTHER
}

model ReturnRequest {
  id                String       @id @default(cuid())
  orderId           String
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId        String?
  customer          Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status            ReturnStatus @default(REQUESTED)
  reason            ReturnReason
  comment           String?
  photoUrls         String[]     @default([])
  items             Json // [{ orderItemId, titleSnapshot, skuSnapshot, variantId, quantity }]
  staffNote         String?
  refundAmountMinor Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status])
  @@index([orderId])
  @@index([customerId])
  @@map("return_requests")
}
