{
  "$description": "Aloravie brand design tokens. Single source of truth for web, apps and admin. Derived from the Logo Identity Guidelines.",
  "brand": {
    "name": "Aloravie",
    "tagline": "Dressed up in first light",
    "pronunciation": "a·lor·a·VEE"
  },
  "color": {
    "terracotta": { "value": "#C8714F", "role": "accent, buttons, logo background, bags", "shareOfUse": "30%" },
    "cream":      { "value": "#FFF8F0", "role": "backgrounds, paper, logo on dark", "shareOfUse": "50%" },
    "cocoa":      { "value": "#3A2620", "role": "body text, evening/dark surfaces", "shareOfUse": "12%" },
    "sand":       { "value": "#E9DCCB", "role": "soft panels, packaging", "shareOfUse": "5%" },
    "clay":       { "value": "#8A5A44", "role": "small labels, captions", "shareOfUse": "3%" }
  },
  "semantic": {
    "light": {
      "bg": "#FFF8F0",
      "surface": "#FFFCF8",
      "panel": "#E9DCCB",
      "text": "#3A2620",
      "muted": "#8A5A44",
      "accent": "#C8714F",
      "onAccent": "#FFF8F0",
      "line": "#E4D6C4"
    },
    "evening": {
      "bg": "#3A2620",
      "surface": "#43302A",
      "panel": "#4A332B",
      "text": "#FFF8F0",
      "muted": "#E9DCCB",
      "accent": "#D98363",
      "onAccent": "#2A1A15",
      "line": "#513A31"
    }
  },
  "typography": {
    "family": "Jost, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
    "source": "Google Fonts",
    "weights": {
      "headline": { "weight": 500, "case": "sentence", "use": "logo, headlines" },
      "label":    { "weight": 400, "case": "uppercase", "letterSpacing": "0.06em", "use": "labels, buttons, prices" },
      "body":     { "weight": 300, "case": "sentence", "use": "tagline, body text, product descriptions" }
    },
    "readabilityRule": "Cream on terracotta for logo and large headlines only. Small text: cocoa or clay on cream."
  },
  "logo": {
    "wordmark": "lowercase 'aloravie', dot of the 'i' is a rising sun",
    "neverRetype": true,
    "files": ["aloravie-primary", "aloravie-on-cream", "aloravie-on-cocoa", "aloravie-transparent-terracotta", "aloravie-transparent-white", "aloravie-profile-icon"]
  },
  "currency": { "default": "INR", "symbol": "₹", "minorUnit": "paise" }
}
